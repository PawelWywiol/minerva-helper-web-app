{
  "name": "minerva-helper-web-app",
  "version": "0.1.0",
  "private": true,
  "description": "Pick single games out of the MiNERVA archive from a browser, packaged as a Docker image",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "gradle": "./scripts/gradle.sh",
    "build": "./scripts/gradle.sh build",
    "test": "./scripts/gradle.sh test",
    "lint": "pnpm lint:js && pnpm lint:kotlin && pnpm lint:sh && pnpm lint:docker && pnpm lint:actions",
    "lint:kotlin": "./scripts/gradle.sh ktlintCheck",
    "lint:sh": "docker run --rm -v \"$PWD:/mnt\" koalaman/shellcheck:v0.11.0 scripts/gradle.sh",
    "lint:docker": "docker run --rm -i hadolint/hadolint:v2.15.1 < Dockerfile",
    "lint:actions": "docker run --rm -u \"$(id -u):$(id -g)\" -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12 -color",
    "scan:image": "docker build -t minerva-helper-web-app:scan . && docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:0.76.1 image --quiet --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 minerva-helper-web-app:scan",
    "secrets": "docker run --rm -v \"$PWD:/repo\" zricethezav/gitleaks:v8.30.1 git --redact --verbose /repo",
    "audit": "pnpm dlx audit-ci@7.1.0 --config ./audit-ci.jsonc",
    "deps:check": "pnpm outdated --include-github-actions",
    "release": "commit-and-tag-version --no-verify",
    "lint:js": "oxlint --deny-warnings src/main/resources/web"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "commit-and-tag-version": "13.3.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.16.1"
}
